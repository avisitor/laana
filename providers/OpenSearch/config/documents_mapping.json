{
  "settings": {
    "analysis": {
      "char_filter": {
        "remove_okina": {
          "type": "mapping",
          "mappings": [
            "\u02bb=>"
          ]
        }
      },
      "analyzer": {
        "folding_analyzer": {
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding"
          ],
          "char_filter": [
            "remove_okina"
          ]
        }
      }
    },
    "index.knn": true
  },
  "mappings": {
    "_meta": {
      "model": "intfloat/multilingual-e5-large-instruct",
      "version": "2.1.0",
      "description": "Hawaiian language corpus - Documents index with full-text search and metadata.",
      "changelog": [
        "2.1.0: Added text_vector_1024 for large-instruct model",
        "2.0.0: Split from combined index - document-level fields only"
      ]
    },
    "properties": {
      "created_at": {
        "type": "date"
      },
      "doc_id": {
        "type": "keyword"
      },
      "groupname": {
        "type": "keyword"
      },
      "sourcename": {
        "type": "keyword"
      },
      "sourceid": {
        "type": "keyword"
      },
      "title": {
        "type": "text"
      },
      "date": {
        "type": "date"
      },
      "authors": {
        "type": "keyword"
      },
      "link": {
        "type": "keyword"
      },
      "hawaiian_word_ratio": {
        "type": "float"
      },
      "text": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          },
          "raw": {
            "type": "keyword",
            "store": true,
            "doc_values": true,
            "ignore_above": 50000
          },
          "folded": {
            "type": "text",
            "analyzer": "folding_analyzer"
          }
        }
      },
      "text_chunks": {
        "type": "nested",
        "properties": {
          "chunk_index": {
            "type": "integer"
          },
          "chunk_text": {
            "type": "text",
            "fields": {
              "raw": {
                "type": "keyword",
                "store": true,
                "doc_values": true,
                "ignore_above": 50000
              },
              "folded": {
                "type": "text",
                "analyzer": "folding_analyzer"
              }
            }
          },
          "chunk_start": {
            "type": "integer"
          },
          "chunk_length": {
            "type": "integer"
          }
        }
      },
      "text_vector": {
        "type": "knn_vector",
        "dimension": 384,
        "method": {
          "name": "hnsw",
          "space_type": "cosinesimil",
          "engine": "lucene"
        }
      },
      "text_vector_1024": {
        "type": "knn_vector",
        "dimension": 1024,
        "method": {
          "name": "hnsw",
          "space_type": "cosinesimil",
          "engine": "lucene"
        }
      },
      "word_count": {
        "type": "integer"
      },
      "sentence_count": {
        "type": "integer"
      },
      "entity_count": {
        "type": "integer"
      },
      "boilerplate_score": {
        "type": "float"
      }
    },
    "_source": {
      "excludes": [
        "text_vector",
        "text_vector_1024"
      ]
    }
  }
}
