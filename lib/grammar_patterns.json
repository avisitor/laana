{
    "aohe_existential": {"regex": "(^|[,:;])\\s*ʻ?Aʻ?ohe\\s+", "signature": "AOHE (EXISTENTIAL NEG)"},
    "dir_la_no_ia": {"regex": "\\b(?:%%directionals%%|aʻ?e)\\s*la\\s+n[oō]\\s+ia", "signature": "DIRECTIONAL + LA NO IA"},
    "hiki_infinitive": {"regex": "\\bHiki\\s+[^.,?!;:\\\"]*?\\s+ke\\s+[\\wāēīōūʻ]+", "signature": "HIKI + KE"},
    "hoole_kalele_akena": {"regex": "(^|[,:;])\\s*ʻ?Aʻ?ole\\s+na\\s+", "signature": "AAOLE + NA"},
    "hoole_pepeke": {"regex": "(^|[,:;])\\s*ʻ?Aʻ?ole\\s+", "signature": "AAOLE (NEGATIVE)"},
    "hoole_pepeke_aike_he": {"regex": "(^|[,:;])\\s*ʻ?Aʻ?ole\\s+he\\s+", "signature": "AAOLE + HE"},
    "hoole_pepeke_aike_o": {"regex": "(^|[,:;])\\s*ʻ?Aʻ?ole\\s+ʻ?o\\s+", "signature": "AAOLE + O"},
    "hoole_pepeke_painu": {"regex": "(^|[,:;])\\s*ʻ?Aʻ?ole\\s+(?:%%tense_particles%%)\\s+", "signature": "AAOLE + I/E"},
    "i_loko_no_o": {"regex": "(^|[,:;])\\s*I\\s+loko\\s+n[oō]\\s+o\\s+", "signature": "I LOKO NO O"},
    "i_mea_e_painu_ai": {"regex": "(^|[,:;])\\s*I\\s+mea\\s+e\\s+.*?\\s+ai\\b", "signature": "I MEA E ... AI"},
    "kalele_akena": {"regex": "(^|[,:;])\\s*Na\\s+[\\wāēīōūʻ]+\\s+i\\s+", "signature": "NA + ACTOR + I + VERB"},
    "kalele_kulana": {"regex": "^\\s*(?!(?:%%conjunctions%%)\\s+(laila|lailla|lāila|ka mea|ia mea|kēlā mea|kela mea)\\b)(?:%%prepositions%%|Ma muli o)\\s+[^.,?!;:\\\"]*?\\s+ai[\\s,.]", "signature": "PREP_FRONTING + AI"},
    "kalele_kumua": {"regex": "(^|[,:;])\\s*Mai\\s+(?:(?:%%articles+demonstratives+locatives+possessives+possessive_prepositions%%)\\b[^\\s,;:!?]*(?:[\\s,]+(?!(?:%%conjunctions+particles%%)\\s)[^\\s,;:!?]+){0,6}|(?!(?:%%verbs+function_words%%)\\b)[A-Za-zʻ\\(\\)\\.\\-]+\\b)\\s+mai", "signature": "MAI + ... + MAI"},
    "ma_ke_ano_he": {"regex": "\\bma\\s+ke\\s+ʻ?ano\\s+he\\b", "signature": "MA KE ANO HE"},
    "o_ka_v_dir_la": {"regex": "(^|[,:;])\\s*ʻ?O\\s+(?:%%articles%%)\\s+[^.,?!;:\\\"]*?\\s+(?:ala|%%directionals%%|aʻ?e)\\s*la\\s+n[oō]\\s+ia", "signature": "O KA VERB DIR LA NO IA"},
    "pepeke_aike_he": {"regex": "(^|[,:;])\\s*He\\s+[\\wāēīōūʻ]+\\s+", "signature": "HE + KIKINO"},
    "pepeke_aike_o": {"regex": "(^|[,:;])\\s*ʻ?O\\s+[\\wāēīōūʻ]+\\s+[\\wāēīōūʻ]+", "signature": "O + NAME"},
    "pepeke_e_aho": {"regex": "\\be aho\\s+", "signature": "E AHO"},
    "pepeke_henua": {"regex": "(^|[,:;])\\s*[aA]ia\\s+", "signature": "AIA + LOCATIVE"},
    "pepeke_nonoa": {"regex": "(^|[,:;])\\s*He\\s+.*?\\s+(?:%%possessives+possessive_prepositions%%)\\s+", "signature": "HE ... KO/KA"},
    "pepeke_oi_aku": {"regex": "(^|[,:;])\\s*ʻ?Oi\\s+aku\\s+", "signature": "OI AKU"},
    "pepeke_painu": {"regex": "(^|[,:;])\\s*(?:%%tense_particles%%)\\s+[\\wāēīōūʻ]+", "signature": "TENSE + VERB"},
    "pepeke_painu_ana": {"regex": "(^|[,:;])\\s*e\\s+(?!(?:%%function_words%%)\\b)[A-Za-zāēīōūĀĒĪŌŪʻ]+\\b(?:\\s+(?:%%directionals+locatives+particles%%)\\b)?\\s+ana\\b", "signature": "E + VERB + ANA (FUTURE/CONT)"}
}
