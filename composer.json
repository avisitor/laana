{
  "require": {
    "elasticsearch/elasticsearch": "^8.13",
    "guzzlehttp/guzzle": "^7.9",
    "nategood/httpful": "^0.3.2",
    "nlp-tools/nlp-tools": "dev-master",
    "avisitor/dbbase": "dev-master",
    "avisitor/dbuser": "dev-master",
    "avisitor/authz-client": "dev-master",
    "avisitor/idp-client": "^2.0",
    "avisitor/monolog-context": "^2.0",
    "opensearch-project/opensearch-php": "^2.5",
    "symfony/dom-crawler": "^7.4",
    "symfony/css-selector": "^7.4",
    "avisitor/env-loader": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Noiiolelo\\": "lib/",
      "Noiiolelo\\Providers\\": "providers/",
      "HawaiianSearch\\": [
        "providers/Elasticsearch/src/",
        "providers/OpenSearch/src/"
      ],
      "Noiiolelo\\Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/avisitor/idp-client"
    },
    {
      "type": "vcs",
      "url": "https://github.com/avisitor/monolog-context"
    },
    {
      "type": "vcs",
      "url": "https://github.com/avisitor/dbbase.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/avisitor/dbuser.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/avisitor/authorization.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/avisitor/authz-client"
    },
    {
      "type": "vcs",
      "url": "https://github.com/avisitor/env-loader.git"
    }
  ],
  "scripts": {
    "test": "phpunit --configuration tests/phpunit.xml",
    "test-json": "phpunit --configuration tests/phpunit.xml --log-json tests/results.json",
    "post-install-cmd": [
      "@setup-ulukau",
      "@install-auth-bin"
    ],
    "post-update-cmd": [
      "@setup-ulukau",
      "@install-auth-bin"
    ],
    "setup-ulukau": [
      "cd db/ulukau && npm install",
      "mkdir -p db/ulukau/output"
    ],
    "install-auth-bin": [
      "mkdir -p bin",
      "ln -sf ../vendor/avisitor/authz-client/bin/auth bin/auth"
    ]
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "audit": {
      "ignore": [
        "PKSA-4dtf-ym9h-t41j"
      ]
    }
  }
}
